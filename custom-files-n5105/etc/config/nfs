
config share
	option enabled '1'
	option path '/mnt/nvme0n1p3'
	option clients '*'
	option options 'rw,fsid=2,sync,no_root_squash,insecure,no_subtree_check'

config share
	option enabled '0'
	option path '/mnt'
	option clients '*'
	option options 'rw,fsid=1,sync,no_root_squash,insecure,no_subtree_check'

config mount
	option enabled '1'
	option source '192.168.30.10:/mnt/mmcblk2p4'
	option target '/mnt/nfs/x96max'
	option delay '5'
	option options 'rw,nolock'

config mount
	option enabled '1'
	option source '192.168.30.10:/mnt/sda1'
	option target '/mnt/nfs/sda1'
	option options 'rw,nolock'
	option delay '5'


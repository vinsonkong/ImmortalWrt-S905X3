
config share
	option enabled '0'
	option path '/mnt/mmcblk2p4'
	option clients '*'
	option options 'rw,fsid=2,sync,no_root_squash,insecure,no_subtree_check'

config share
	option enabled '0'
	option path '/mnt'
	option clients '*'
	option options 'rw,fsid=1,sync,no_root_squash,insecure,no_subtree_check'



config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fddc:52f6:ea41::/48'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.2.100/24'
	list dns '127.0.0.1'
	list dns '223.5.5.5'
	list dns '119.29.29.29'
	list dns '8.8.8.8'

config interface 'lan6'
	option proto 'dhcpv6'
	option device '@lan'
	option reqaddress 'try'
	option reqprefix 'auto'
	option norelease '1'
	option sourcefilter '0'
	option delegate '0'

config interface 'docker'
	option device 'docker0'
	option proto 'none'
	option auto '0'
	option defaultroute '0'

config device
	option type 'bridge'
	option name 'docker0'

config interface 'wwan'
	option proto 'dhcp'

config route
	option target '192.168.2.0/24'
	option gateway '192.168.193.192'
	option disabled '1'

config interface 'EasyTier'
	option proto 'none'
	option device 'tun0'
	option ifname 'tun0'


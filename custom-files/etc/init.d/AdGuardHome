#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=01

# ====================== 【全局可修改路径变量区】统一修改入口 ======================
# AdGuardHome 二进制程序路径
BIN_PATH="/usr/bin/AdGuardHome"
# AGH 工作数据目录
WORK_DIR="/mnt/mmcblk2p4/AdGuardHome"
# AGH yaml配置文件
YAML_CONFIG="/etc/AdGuardHome/AdGuardHome.yaml"

# 配套脚本路径
FW_SCRIPT="/usr/share/AdGuardHome/firewall.start"
WAITNET_SCRIPT="/usr/share/AdGuardHome/waitnet.sh"
WATCHCONFIG_SCRIPT="/usr/share/AdGuardHome/watchconfig.sh"
UPDATE_CORE_SCRIPT="/usr/share/AdGuardHome/update_core.sh"
TAILTO_SCRIPT="/usr/share/AdGuardHome/tailto.sh"
ADDHOST_SCRIPT="/usr/share/AdGuardHome/addhost.sh"
GFW2ADG_SCRIPT="/usr/share/AdGuardHome/gfw2adg.sh"

# 定时任务文件
CRON_FILE="/etc/crontabs/root"
# 升级保留目录
UPGRADE_KEEP_FILE="/lib/upgrade/keep.d/luci-app-adguardhome"
# 更新日志
UPDATE_LOG="/tmp/AdGuardHome_update.log"

# 运行临时标识文件
FLAG_REDIRECT="/var/run/AdGredir"
FLAG_SERVER_DIS="/var/run/AdGserverdis"
FLAG_LUCI_TEST="/var/run/AdGlucitest"
# ==============================================================================

CONFIGURATION=AdGuardHome
EXTRA_COMMANDS="do_redirect testbackup test_crontab force_reload isrunning help"
EXTRA_HELP="        do_redirect 0 or 1
        testbackup backup or restore
        test_crontab
        force_reload
        isrunning
        help"

# 全局容错
set -o pipefail

# 日志工具封装
log_info() { logger -t AdGuardHome -p info "$1"; echo "[INFO] $1"; }
log_warn() { logger -t AdGuardHome -p warn "$1"; echo "[WARN] $1"; }
log_err()  { logger -t AdGuardHome -p err "$1"; echo "[ERROR] $1"; }

# NAT内核模块加载
load_nat_mod() {
    modprobe iptable_nat 2>/dev/null || log_warn "iptables nat模块加载失败，IPv4转发异常"
    modprobe ip6table_nat 2>/dev/null || log_warn "ip6tables nat模块缺失，IPv6转发不可用"
}

set_forward_dnsmasq()
{
	local PORT="$1"
	addr="127.0.0.1#$PORT"
	OLD_SERVER="$(uci get dhcp.@dnsmasq[0].server 2>/dev/null || true)"
	echo "$OLD_SERVER" | grep "^$addr" >/dev/null 2>&1
	if [ $? -eq 0 ]; then
		return
	fi
	uci delete dhcp.@dnsmasq[0].server 2>/dev/null
	uci add_list dhcp.@dnsmasq[0].server="$addr"
	for server in $OLD_SERVER; do
		if [ "$server" = "$addr" ]; then
			continue
		fi
		uci add_list dhcp.@dnsmasq[0].server="$server"
	done
	uci delete dhcp.@dnsmasq[0].resolvfile 2>/dev/null
	uci set dhcp.@dnsmasq[0].noresolv=1
	uci commit dhcp
	/etc/init.d/dnsmasq restart
	log_info "dnsmasq上游DNS已设置为 $addr"
}

stop_forward_dnsmasq()
{
	local OLD_PORT="$1"
	addr="127.0.0.1#$OLD_PORT"
	OLD_SERVER="$(uci get dhcp.@dnsmasq[0].server 2>/dev/null || true)"
	echo "$OLD_SERVER" | grep "^$addr" >/dev/null 2>&1
	if [ $? -ne 0 ]; then
		return
	fi

	uci del_list dhcp.@dnsmasq[0].server="$addr" 2>/dev/null
	addrlist="$(uci get dhcp.@dnsmasq[0].server 2>/dev/null || true)"
	if [ -z "$addrlist" ] ; then
		uci set dhcp.@dnsmasq[0].resolvfile=/tmp/resolv.conf.auto 2>/dev/null
		uci delete dhcp.@dnsmasq[0].noresolv 2>/dev/null
	fi
	uci commit dhcp
	/etc/init.d/dnsmasq restart
	log_info "已移除dnsmasq上游转发 $addr"
}

set_iptable()
{
	local ipv6_server="$1"
	local tcp_server="$2"
	load_nat_mod

	uci -q batch <<-EOF >/dev/null 2>&1
delete firewall.AdGuardHome
set firewall.AdGuardHome=include
set firewall.AdGuardHome.type=script
set firewall.AdGuardHome.path=${FW_SCRIPT}
set firewall.AdGuardHome.reload=1
commit firewall
EOF

	IPS="$(ip addr | awk '/inet / && !/127.0.0.1/ {split($2,ip,"/"); print ip[1]}' | sort -u)"
	for IP in $IPS
	do
		if [ "$tcp_server" == "1" ]; then
			iptables -t nat -A PREROUTING -p tcp -d "$IP" --dport 53 -j REDIRECT --to-ports "$AdGuardHome_PORT" >/dev/null 2>&1
		fi
		iptables -t nat -A PREROUTING -p udp -d "$IP" --dport 53 -j REDIRECT --to-ports "$AdGuardHome_PORT" >/dev/null 2>&1
	done

	if [ "$ipv6_server" == 0 ]; then
		return
	fi

	IPS="$(ip addr | awk '/inet6 / && !/fe80::/ && !/::1/ {split($2,ip,"/"); print ip[1]}' | sort -u)"
	for IP in $IPS
	do
		if [ "$tcp_server" == "1" ]; then
			ip6tables -t nat -A PREROUTING -p tcp -d "$IP" --dport 53 -j REDIRECT --to-ports "$AdGuardHome_PORT" >/dev/null 2>&1
		fi
		ip6tables -t nat -A PREROUTING -p udp -d "$IP" --dport 53 -j REDIRECT --to-ports "$AdGuardHome_PORT" >/dev/null 2>&1
	done
	log_info "53端口劫持规则已创建，端口:$AdGuardHome_PORT"
}

clear_iptable()
{
	local OLD_PORT="$1"
	local ipv6_server="$2"
	load_nat_mod

	uci -q batch <<-EOF >/dev/null 2>&1
delete firewall.AdGuardHome
commit firewall
EOF
	IPS="$(ip addr | awk '/inet / && !/127.0.0.1/ {split($2,ip,"/"); print ip[1]}' | sort -u)"
	for IP in $IPS
	do
		iptables -t nat -D PREROUTING -p udp -d "$IP" --dport 53 -j REDIRECT --to-ports "$OLD_PORT" >/dev/null 2>&1
		iptables -t nat -D PREROUTING -p tcp -d "$IP" --dport 53 -j REDIRECT --to-ports "$OLD_PORT" >/dev/null 2>&1
	done

	if [ "$ipv6_server" == 0 ]; then
		return
	fi
	log_warn "清理IPv6 NAT转发规则，请确保ip6tables nat模块已加载"
	IPS="$(ip addr | awk '/inet6 / && !/fe80::/ && !/::1/ {split($2,ip,"/"); print ip[1]}' | sort -u)"
	for IP in $IPS
	do
		ip6tables -t nat -D PREROUTING -p udp -d "$IP" --dport 53 -j REDIRECT --to-ports "$OLD_PORT" >/dev/null 2>&1
		ip6tables -t nat -D PREROUTING -p tcp -d "$IP" --dport 53 -j REDIRECT --to-ports "$OLD_PORT" >/dev/null 2>&1
	done
	log_info "旧端口 $OLD_PORT 转发规则已清空"
}

service_triggers() {
	procd_add_reload_trigger "$CONFIGURATION"
	local redirect_mode
	redirect_mode="$(uci get AdGuardHome.AdGuardHome.redirect 2>/dev/null || true)"
	[ "$redirect_mode" == "redirect" ] && procd_add_reload_trigger firewall
}

isrunning(){
	config_load "${CONFIGURATION}"
	_isrunning
	local r=$?
	case $r in
		0) echo "running" ;;
		1) echo "not run" ;;
		2) echo "no bin" ;;
	esac
	return $r
}

_isrunning(){
	[ ! -f "$BIN_PATH" ] && return 2
	pgrep -f "^$BIN_PATH" 2>&1 >/dev/null && return 0
	return 1
}

force_reload(){
	config_load "${CONFIGURATION}"
	if _isrunning; then
		procd_send_signal "$CONFIGURATION" SIGHUP
		log_info "发送SIGHUP热重载AdGuardHome配置"
	else
		log_warn "进程未运行，执行start启动服务"
		start
	fi
}

get_tz()
{
	SET_TZ=""
	if [ -e "/etc/localtime" ]; then
		return
	fi
	for tzfile in /etc/TZ /var/etc/TZ
	do
		if [ ! -e "$tzfile" ]; then
			continue
		fi
		tz="$(cat "$tzfile" 2>/dev/null)"
	done
	if [ -z "${tz:-}" ]; then
		return
	fi
	SET_TZ="$tz"
}

rm_port53()
{
	local AdGuardHome_PORT
	AdGuardHome_PORT=$(config_editor "dns.port" "" "$YAML_CONFIG" "1")
	dnsmasq_port="$(uci get dhcp.@dnsmasq[0].port 2>/dev/null || echo "53")"
	if [ "$dnsmasq_port" == "$AdGuardHome_PORT" ]; then
		if [ "$dnsmasq_port" == "53" ]; then
			dnsmasq_port="1745"
		fi
	elif [ "$dnsmasq_port" == "53" ]; then
		return
	fi
	config_editor "dns.port" "$dnsmasq_port" "$YAML_CONFIG"
	uci set dhcp.@dnsmasq[0].port="53"
	uci commit dhcp
	/etc/init.d/dnsmasq reload
	log_info "端口交换：dnsmasq占用53，AGH切换至$dnsmasq_port"
}

use_port53()
{
	local AdGuardHome_PORT
	AdGuardHome_PORT=$(config_editor "dns.port" "" "$YAML_CONFIG" "1")
	dnsmasq_port="$(uci get dhcp.@dnsmasq[0].port 2>/dev/null || echo "53")"
	if [ "$dnsmasq_port" == "$AdGuardHome_PORT" ]; then
		if [ "$dnsmasq_port" == "53" ]; then
			AdGuardHome_PORT="1745"
		fi
	elif [ "$AdGuardHome_PORT" == "53" ]; then
		return
	fi
	config_editor "dns.port" "53" "$YAML_CONFIG"
	uci set dhcp.@dnsmasq[0].port="$AdGuardHome_PORT"
	uci commit dhcp
	/etc/init.d/dnsmasq reload
	log_info "端口交换：AGH占用53，dnsmasq切换至$AdGuardHome_PORT"
}

do_redirect()
{
	config_load "${CONFIGURATION}"
	_do_redirect "$1"
}

_do_redirect()
{
	local section="$CONFIGURATION"
	ipv6_server=1
	tcp_server=0
	enabled="$1"
	if [ "$enabled" == "1" ]; then
		echo -n "1" > "$FLAG_REDIRECT"
	else
		echo -n "0" > "$FLAG_REDIRECT"
	fi
	AdGuardHome_PORT=$(config_editor "dns.port" "" "$YAML_CONFIG" "1")
	if [ -z "$AdGuardHome_PORT" ]; then
		AdGuardHome_PORT="0"
	fi
	config_get redirect "$section" redirect "none"
	config_get old_redirect "$section" old_redirect "none"
	config_get old_port "$section" old_port "0"
	config_get old_enabled "$section" old_enabled "0"
	uci get dhcp.@dnsmasq[0].port >/dev/null 2>&1 || uci set dhcp.@dnsmasq[0].port="53" >/dev/null 2>&1
	if [ "$old_enabled" = "1" ] && [ "$old_redirect" == "exchange" ]; then
		AdGuardHome_PORT="$(uci get dhcp.@dnsmasq[0].port 2>/dev/null)"
	fi

	if [ "$old_redirect" != "$redirect" ] || [ "$old_port" != "$AdGuardHome_PORT" ] || ([ "$old_enabled" = "1" ] && [ "$enabled" = "0" ]); then
		if [ "$old_redirect" != "none" ]; then
			if [ "$old_redirect" == "redirect" ] && [ "$old_port" != "0" ]; then
				clear_iptable "$old_port" "$ipv6_server"
			elif [ "$old_redirect" == "dnsmasq-upstream" ]; then
				stop_forward_dnsmasq "$old_port"
			elif [ "$old_redirect" == "exchange" ]; then
				rm_port53
			fi
		fi
	elif [ "$old_enabled" = "1" ] && [ "$enabled" = "1" ]; then
		if [ "$old_redirect" == "redirect" ] && [ "$old_port" != "0" ]; then
			clear_iptable "$old_port" "$ipv6_server"
		fi
	fi
	uci delete AdGuardHome.@AdGuardHome[0].old_redirect 2>/dev/null
	uci delete AdGuardHome.@AdGuardHome[0].old_port 2>/dev/null
	uci delete AdGuardHome.@AdGuardHome[0].old_enabled 2>/dev/null
	uci add_list AdGuardHome.@AdGuardHome[0].old_redirect="$redirect" 2>/dev/null
	uci add_list AdGuardHome.@AdGuardHome[0].old_port="$AdGuardHome_PORT" 2>/dev/null
	uci add_list AdGuardHome.@AdGuardHome[0].old_enabled="$enabled" 2>/dev/null
	uci commit AdGuardHome
	[ "$enabled" == "0" ] && return 1
	if [ "$AdGuardHome_PORT" == "0" ]; then
		log_err "AGH DNS端口为空，无法开启转发"
		return 1
	fi
	if [ "$redirect" = "redirect" ]; then
		set_iptable "$ipv6_server" "$tcp_server"
	elif [ "$redirect" = "dnsmasq-upstream" ]; then
		set_forward_dnsmasq "$AdGuardHome_PORT"
	elif [ "$redirect" == "exchange" ] && [ "$(uci get dhcp.@dnsmasq[0].port 2>/dev/null)" == "53" ]; then
		use_port53
	fi
}

get_filesystem()
{
    echo "$1" | awk '
    BEGIN{
    while (("mount"| getline ret) > 0)
    {
    split(ret,d);
    fs[d[3]]=d[5];
    m=index(d[1],":")
    if (m==0)
    {
        pt[d[3]]=d[1]
    }else{
        pt[d[3]]=substr(d[1],m+1)
    }}}{
    split($0,d,"/");
    if ("/" in fs)
    {
    result1=fs["/"];
    }
    if ("/" in pt)
    {
    result2=pt["/"];
    }
    for (i=2;i<=length(d);i++)
    {
       p[i]=p[i-1]"/"d[i];
       if (p[i] in fs)
        {
        result1=fs[p[i]];
        result2=pt[p[i]];
        }
    }
    if (result2 in fs){
        result=fs[result2]}
    else{
        result=result1}
    print(result);}'
}

config_editor()
{
	local yaml="$1"
	local value="$2"
	local file="$3"
	local ro="$4"
	local esc_val
	esc_val=$(echo "$value" | sed "s/'/'\\''/g")
	awk -v yaml="$yaml" -v value="$esc_val" -v file="$file" -v ro="$ro" '
	BEGIN{split(yaml,part,"[.]");s="";i=1;l=length(part);}
    {
        if (match($0,s""part[i]":"))
        {
            if (i==l)
            {
                split($0,t,": ");
				if (ro==""){
					system("sed -i '\''"FNR"c \\"t[1]": "value"'\'' "file);
				}else{
					print(t[2]);
				}
				exit;
            }
            s=s"[- ]{2}";
            i++;
        }
    }' "$file"
}

boot_service() {
	rm -f "$FLAG_SERVER_DIS" >/dev/null 2>&1
	config_load "${CONFIGURATION}"
	config_get waitonboot "$CONFIGURATION" waitonboot "0"
	config_get_bool enabled "$CONFIGURATION" enabled 0
	[ -f "$BIN_PATH" ] && start_service
	if [ "$enabled" == "1" ] && [ "$waitonboot" == "1" ] && [ -f "$WAITNET_SCRIPT" ]; then
		procd_open_instance "waitnet"
		procd_set_param command "$WAITNET_SCRIPT"
		procd_close_instance
		log_info "已创建开机等待网络进程"
	fi
}

testbackup(){
	config_load "${CONFIGURATION}"
	if [ "$1" == "backup" ]; then
		backup
	elif [ "$1" == "restore" ]; then
		restore
	else
		log_err "参数错误，用法 testbackup backup|restore"
	fi
}

restore()
{
	config_get workdir "$CONFIGURATION" workdir "$WORK_DIR"
	config_get backupwdpath "$CONFIGURATION" backupwdpath "$WORK_DIR"
	mkdir -p "$workdir/data" "$backupwdpath/data"
	if [ ! -d "$backupwdpath/data" ]; then
		log_warn "备份目录不存在，跳过恢复"
		return 1
	fi
	cp -u -r -f "$backupwdpath/data" "$workdir/"
	log_info "数据恢复完成"
}

backup() {
	config_get backupwdpath "$CONFIGURATION" backupwdpath "$WORK_DIR"
	mkdir -p "$backupwdpath/data"
	config_get workdir "$CONFIGURATION" workdir "$WORK_DIR"
	config_get backupfile "$CONFIGURATION" backupfile ""
	if [ -z "$backupfile" ]; then
		log_warn "未配置备份文件列表，跳过备份"
		return
	fi
	for one in $backupfile;
	do
		while :
		do
			local src="$workdir/data/$one"
			local dst="$backupwdpath/data/$one"
			local cpret
			if [ -d "$dst" ]; then
				cpret=$(cp -u -r -f "$src" "$backupwdpath/data" 2>&1 || true)
			else
				cpret=$(cp -u -r -f "$src" "$dst" 2>&1 || true)
			fi
			if echo "$cpret" | grep -q "no space left on device"; then
				log_warn "磁盘空间不足，自动清理查询日志重试"
				del_querylog
				rm -f -r "$backupwdpath/data/filters" "$workdir/data/filters" 2>/dev/null
				continue
			fi
			[ -n "$cpret" ] && log_warn "备份警告: $cpret"
			break
		done
	done
	log_info "定时备份执行完成"
}

start_service() {
	rm -f "$FLAG_SERVER_DIS" >/dev/null 2>&1
	config_load "${CONFIGURATION}"
	config_get hashpass "$CONFIGURATION" hashpass ""
	if [ -n "$hashpass" ]; then
		config_editor "users.password" "$hashpass" "$YAML_CONFIG"
		uci set "$CONFIGURATION.$CONFIGURATION.hashpass"=""
		uci commit "$CONFIGURATION"
	fi
	local enabled
	config_get_bool enabled "$CONFIGURATION" enabled 0
	do_crontab
	if [ "$enabled" == "0" ]; then
		_do_redirect 0
		return
	fi
	config_get workdir "$CONFIGURATION" workdir "$WORK_DIR"
	config_get backupfile "$CONFIGURATION" backupfile ""
	mkdir -p "$workdir/data" "$(dirname "$YAML_CONFIG")"
	chmod 600 "$YAML_CONFIG" 2>/dev/null
	if [ -n "$backupfile" ] && [ ! -d "$workdir/data" ]; then
		restore
	fi
	local cwdfs
	cwdfs=$(get_filesystem "$workdir")
	log_info "工作目录文件系统: $cwdfs"
	if [ "$cwdfs" == "jffs2" ]; then
		log_warn "JFFS2闪存，数据库软链接至/tmp减少擦写"
		for db in stats.db sessions.db; do
			local db_file="$workdir/data/$db"
			local tmp_db="/tmp/$db"
			touch "$db_file"
			if [ ! -L "$db_file" ]; then
				mv -f "$db_file" "$tmp_db" 2>/dev/null
				ln -s "$tmp_db" "$db_file" 2>/dev/null
			fi
		done
	fi
	local ADDITIONAL_ARGS=""
	mkdir -p "${BIN_PATH%/*}"
	ADDITIONAL_ARGS="$ADDITIONAL_ARGS -c $YAML_CONFIG"
	ADDITIONAL_ARGS="$ADDITIONAL_ARGS -w $workdir"
	config_get httpport "$CONFIGURATION" httpport 3000
	ADDITIONAL_ARGS="$ADDITIONAL_ARGS -p $httpport"
	config_get upprotect "$CONFIGURATION" upprotect ""
	echo "$upprotect" | tr ' ' '\n' > "$UPGRADE_KEEP_FILE"
	config_get logfile "$CONFIGURATION" logfile ""
	if [ -n "$logfile" ]; then
		ADDITIONAL_ARGS="$ADDITIONAL_ARGS -l $logfile"
	fi
	if [ ! -f "$BIN_PATH" ]; then
		log_err "AdGuardHome二进制缺失，后台执行更新脚本"
		_do_redirect 0
		"$UPDATE_CORE_SCRIPT" 2>&1 > "$UPDATE_LOG" &
		exit 0
	fi
	config_get_bool verbose "$CONFIGURATION" verbose 0
	if [ "$verbose" -eq 1 ]; then
		ADDITIONAL_ARGS="$ADDITIONAL_ARGS -v"
	fi
	procd_open_instance
	get_tz
	if [ -n "${SET_TZ:-}" ]; then
		procd_set_param env TZ="$SET_TZ"
	fi
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param limits core="unlimited" nofile="unlimited"
	procd_set_param stderr 1
	procd_set_param command "$BIN_PATH" $ADDITIONAL_ARGS
	procd_set_param file "$YAML_CONFIG" "/etc/hosts" "/etc/config/AdGuardHome"
	procd_close_instance
	if [ -f "$YAML_CONFIG" ]; then
		_do_redirect 1
	else
		_do_redirect 0
		local redirect
		config_get redirect "AdGuardHome" "redirect" "none"
		if [ "$redirect" != "none" ]; then
			procd_open_instance "waitconfig"
			procd_set_param command "$WATCHCONFIG_SCRIPT"
			procd_close_instance
			log_info "配置文件不存在，启动监控脚本等待配置生成"
		fi
	fi
	log_info "AdGuardHome服务已启用，开关状态:$enabled"
	(sleep 10 && [ -z "$(pgrep -f "^$BIN_PATH")" ] && log_warn "10秒内进程未启动，关闭DNS转发" && _do_redirect 0 )&
}

reload_service()
{
	rm -f "$FLAG_LUCI_TEST" >/dev/null 2>&1
	log_info "执行AdGuardHome重载"
	start
}

del_querylog(){
	local backupwdpath workdir
	config_get backupwdpath "$CONFIGURATION" backupwdpath "$WORK_DIR"
	config_get workdir "$CONFIGURATION" workdir "$WORK_DIR"
	local btarget wtarget
	btarget="$(ls "$backupwdpath/data"/querylog.json* 2>/dev/null | sort -r | head -n 1 || true)"
	wtarget="$(ls "$workdir/data"/querylog.json* 2>/dev/null | sort -r | head -n 1 || true)"
	if [ "$btarget" = "$wtarget" ]; then
		[ -z "$btarget" ] && return 1
		rm -f "$workdir/data/$wtarget" "$backupwdpath/data/$btarget"
		return 0
	fi
	if [[ "$btarget" > "$wtarget" ]]; then
		rm -f "$backupwdpath/data/$btarget"
	else
		rm -f "$workdir/data/$wtarget"
	fi
	return 0
}

stop_service()
{
	config_load "${CONFIGURATION}"
	_do_redirect 0
	do_crontab
	if [ "$1" != "nobackup" ]; then
		config_get backupfile "$CONFIGURATION" backupfile "0"
		if [ -n "$backupfile" ]; then
			backup
		fi
	fi
	log_info "AdGuardHome服务停止，已关闭转发规则"
	touch "$FLAG_SERVER_DIS"
}

boot() {
	rc_procd boot_service "$@"
	if eval "type service_started" 2>/dev/null >/dev/null; then
		service_started
	fi
}

test_crontab(){
	config_load "${CONFIGURATION}"
	do_crontab
	log_info "定时任务已重载"
}

do_crontab(){
	config_get_bool enabled "$CONFIGURATION" enabled 0
	config_get crontab "$CONFIGURATION" crontab ""
	local findstr default cronenable replace commit cronreload=0
	# 自动更新核心
	findstr="$UPDATE_CORE_SCRIPT"
	default="30 3 * * * $UPDATE_CORE_SCRIPT 2>&1"
	[ "$enabled" == "0" ] || [[ ! "$crontab" =~ autoupdate ]] && cronenable=0 || cronenable=1
	crontab_editor

	# 切割查询日志
	config_get workdir "$CONFIGURATION" workdir "$WORK_DIR"
	config_get lastworkdir "$CONFIGURATION" lastworkdir "$WORK_DIR"
	findstr="$TAILTO_SCRIPT [0-9]* \$(uci get AdGuardHome.AdGuardHome.workdir)/data/querylog.json"
	default="0 * * * * $TAILTO_SCRIPT 2000 \$(uci get AdGuardHome.AdGuardHome.workdir)/data/querylog.json"
	[ "$enabled" == "0" ] || [[ ! "$crontab" =~ cutquerylog ]] && cronenable=0 || cronenable=1
	crontab_editor

	# 切割运行日志
	config_get logfile "$CONFIGURATION" logfile ""
	config_get lastlogfile "$CONFIGURATION" lastlogfile ""
	findstr="$TAILTO_SCRIPT [0-9]* \$(uci get AdGuardHome.AdGuardHome.logfile)"
	default="30 3 * * * $TAILTO_SCRIPT 2000 \$(uci get AdGuardHome.AdGuardHome.logfile)"
	[ "$logfile" == "syslog" ] || [ "$logfile" == "" ] || [ "$enabled" == "0" ] || [[ ! "$crontab" =~ cutruntimelog ]] && cronenable=0 || cronenable=1
	crontab_editor

	# 自动hosts
	findstr="$ADDHOST_SCRIPT"
	default="0 * * * * $ADDHOST_SCRIPT"
	[ "$enabled" == "0" ] || [[ ! "$crontab" =~ autohost ]] && cronenable=0 || cronenable=1
	crontab_editor
	[ "$cronenable" == "0" ] && "$ADDHOST_SCRIPT" "del" "noreload" || "$ADDHOST_SCRIPT" "" "noreload"

	# 自动规则更新
	findstr="$GFW2ADG_SCRIPT"
	default="30 3 * * * $GFW2ADG_SCRIPT"
	[ "$enabled" == "0" ] || [[ ! "$crontab" =~ autogfw ]] && cronenable=0 || cronenable=1
	crontab_editor

	[ "$cronreload" -gt 0 ] && /etc/init.d/cron restart
}

crontab_editor(){
	local testline line reload=""
	local findstr_local="$findstr"
	local default_local="$default"
	local cronenable_local="$cronenable"
	local replace_local="${replace:-}"
	local cronreload_local=0

	line="$(grep "$findstr_local" "$CRON_FILE" 2>/dev/null || true)"
	if [ -n "$replace_local" ] && [ -n "$line" ]; then
		testline="${line//$replace_local}"
		if [ "$testline" != "$line" ]; then
			line="$testline"
			reload="1"
		fi
	fi
	if [ "${line:0:1}" != "#" ]; then
		if [ $cronenable_local -eq 1 ]; then
			if [ -z "$line" ]; then
				line="$default_local"
				reload="1"
			fi
			if [ -n "$reload" ]; then
				sed -i "\,$findstr_local,d" "$CRON_FILE"
				echo "$line" >> "$CRON_FILE"
				cronreload_local=$((cronreload_local+1))
			fi
		elif [ -n "$line" ]; then
			sed -i "\,$findstr_local,d" "$CRON_FILE"
			echo "#$line" >> "$CRON_FILE"
			cronreload_local=$((cronreload_local+1))
		fi
	else
		if [ $cronenable_local -eq 1 ]; then
			sed -i "\,$findstr_local,d" "$CRON_FILE"
			echo "${line:1}" >> "$CRON_FILE"
			cronreload_local=$((cronreload_local+1))
		elif [ -z "$reload" ]; then
			sed -i "\,$findstr_local,d" "$CRON_FILE"
			echo "$line" >> "$CRON_FILE"
		fi
	fi
	cronreload="$cronreload_local"
}

# ====================== rc.common 标准启停函数 ======================
start() {
	boot_service
}

stop() {
	config_load "$CONFIGURATION"
	stop_service ""
	procd_stop "$CONFIGURATION"
	sleep 1
	pkill -f "^$BIN_PATH" 2>/dev/null || true
	log_info "AdGuardHome 服务完全停止"
}

reload() {
	reload_service
}

restart() {
	stop
	sleep 1
	start
}

# 帮助命令
help() {
cat <<EOF
AdGuardHome OpenWrt 服务管理脚本
全局路径修改：脚本顶部【全局可修改路径变量区】
命令列表：
start | stop | restart | reload
isrunning             查看运行状态
do_redirect 0/1       开关53端口DNS劫持转发
testbackup backup/restore 备份/恢复数据
test_crontab          重载定时任务
force_reload          热重载配置(SIGHUP)
help                  打印本帮助
EOF
}

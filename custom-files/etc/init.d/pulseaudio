#!/bin/sh /etc/rc.common
# Copyright (C) 2011 OpenWrt.org

START=99
STOP=65

USE_PROCD=1
# 确认 pulseaudio 二进制文件的实际路径，通常在 /usr/bin 或 /usr/sbin
PROG=/usr/bin/pulseaudio

# 定义运行时目录
RUNTIME_DIR="/var/run/pulse"

start_service() {
    # 1. 创建并配置运行时目录 (XDG_RUNTIME_DIR)
    # 权限 0700 确保安全，仅 root 可读写
    if [ ! -d "$RUNTIME_DIR" ]; then
        mkdir -m 0700 -p "$RUNTIME_DIR"
        chown root:root "$RUNTIME_DIR"
    fi

    # 2. 创建状态/缓存目录
    # PulseAudio 需要写入 cookie 和卡片数据库
    if [ ! -d "/var/lib/pulse" ]; then
        mkdir -m 0755 -p /var/lib/pulse
        chown root:root /var/lib/pulse
    fi

    # 3. 修正音频设备节点权限
    # 确保 audio 组有权限访问硬件
    if [ -d /dev/snd ]; then
        # 只修改字符设备文件 (c) 和块设备文件 (b)，避免修改 .controlC0 等特殊文件出错
        for dev in /dev/snd/*; do
            if [ -e "$dev" ]; then
                chown root:audio "$dev"
                chmod 660 "$dev"
            fi
        done
    fi
    
    # 兼容旧式 OSS 设备节点
    [ -e /dev/mixer ] && chown root:audio /dev/mixer && chmod 660 /dev/mixer
    [ -e /dev/dsp ] && chown root:audio /dev/dsp && chmod 660 /dev/dsp

    # 4. 启动服务实例
    procd_open_instance
    
    # --- 关键配置 ---
    
    # 1. 自动重启配置：如果进程挂掉，等待 5秒 后重启
    procd_set_param respawn
    
    # 2. 设置环境变量 (模拟用户环境的核心)
    procd_set_param env XDG_RUNTIME_DIR="$RUNTIME_DIR"
    procd_set_param env HOME="/root"
    # 显式指定 Runtime Path，防止 PulseAudio 找不到 socket
    procd_set_param env PULSE_RUNTIME_PATH="$RUNTIME_DIR"
    
    # 3. 执行命令
    # 移除了 --system 参数，以 Root 身份运行 User 模式
    procd_set_param command $PROG \
        --disallow-exit \
        --exit-idle-time=-1 \
        --realtime=false \
        --log-target=syslog \
        --log-level=info \
        --daemonize=no # 让 procd 管理后台化，而不是让 pulseaudio 自己 fork

    # 4. 文件句柄限制 (PulseAudio 可能需要较多句柄)
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1024 4096"

    procd_close_instance
}

stop_service() {
    # 使用 procd 发送信号停止进程
    procd_kill $PROG
}

# reload_service() 用于不重启进程重新加载配置 (如果支持)
reload_service() {
    procd_send_signal $PROG HUP
}

#!/bin/sh
#========================================================================
# OpenWrt 通用 /etc 配置还原脚本（二级回滚 + 清理重启）
# 自动适配 OverlayFS / Btrfs / EXT4 / XFS / F2FS
#========================================================================

BACKUP_DIR="${BACKUP_DIR:-/mnt/backup}"
TARGET_NAME="etc"
SOURCE="${BACKUP_DIR}/${TARGET_NAME}"

INFO="\033[94m[INFO]\033[0m"
WARN="\033[93m[WARN]\033[0m"
ERROR="\033[91m[ERROR]\033[0m"
SUCCESS="\033[92m[SUCCESS]\033[0m"

error_exit() { echo -e "${ERROR} $1"; exit 1; }

# ==================== 1. 智能探测真实还原目标 ====================
detect_target() {
    # OverlayFS: 仅操作上层可写目录，避免破坏 /rom 只读底层
    if mount | grep -qE "on / type overlay|on /etc type overlay"; then
        UPPER=$(mount | grep -E "on / type overlay|on /etc type overlay" \
            | sed -n 's/.*upperdir=$[^,]*$.*/\1/p' | head -n1)
        if [ -d "$UPPER/etc" ]; then
            RESTORE_TARGET="$UPPER/etc"
            echo -e "${INFO} 检测到 OverlayFS，还原至可写层: $RESTORE_TARGET"
            return
        fi
    fi
    # 兜底：纯文件系统环境
    RESTORE_TARGET="/etc"
    echo -e "${INFO} 标准环境，还原至: $RESTORE_TARGET"
}

# ==================== 2. 前置校验 ====================
[ "$(id -u)" -eq 0 ] || error_exit "请以 root 权限运行"
[ -d "$SOURCE" ] || error_exit "备份源 [$SOURCE] 不存在，请检查 ${BACKUP_DIR} 挂载状态"
detect_target

# ==================== 3. 原子暂存当前配置 ====================
TEMP_BAK="${RESTORE_TARGET}.rollback_$(date +%Y%m%d%H%M%S)"
echo -e "${INFO} 暂存当前配置到 [$TEMP_BAK]"
mv "$RESTORE_TARGET" "$TEMP_BAK" || error_exit "无法暂存当前配置，可能有进程占用，请先停止相关服务"

# ==================== 4. 一级：覆盖还原 ====================
RESTORE_OK=0
echo -e "${INFO} [1/2] 执行配置还原..."
mkdir -p "$RESTORE_TARGET" 2>/dev/null
cp -a "$SOURCE"/. "$RESTORE_TARGET"/ 2>/dev/null

# 验证还原结果：目录存在且非空
if [ -d "$RESTORE_TARGET" ] && [ "$(find "$RESTORE_TARGET" -maxdepth 1 | wc -l)" -gt 1 ]; then
    RESTORE_OK=1
fi

# ==================== 5. 二级：复制回滚（安全兜底） ====================
if [ "$RESTORE_OK" -ne 1 ]; then
    echo -e "${WARN} [2/2] 还原失败！尝试复制回滚..."
    rm -rf "$RESTORE_TARGET" 2>/dev/null
    if cp -a "$TEMP_BAK"/. "$RESTORE_TARGET"/ 2>/dev/null; then
        rm -rf "$TEMP_BAK"
        error_exit "配置还原失败，已通过复制回滚恢复原始状态（未重启，请排查原因）"
    fi
    # 回滚也失败：保留 TEMP_BAK 供手动抢救
    error_exit "⚠️ 回滚也失败！请手动恢复: mv $TEMP_BAK $RESTORE_TARGET"
fi

# ==================== 6. 成功路径：OpenWrt 专属清理 + 重启 ====================
echo -e "${INFO} 还原验证通过，执行 OpenWrt 专属清理..."
rm -rf "$TEMP_BAK" /tmp/* /var/run/* /var/state/* /var/lock/* 2>/dev/null

# 重建 rc.d 自启动软链接，防止还原后服务丢失
[ -x /etc/init.d/boot ] && /etc/init.d/boot enable 2>/dev/null

sync
echo -e "${SUCCESS} ✅ 配置还原完成！3秒后重启..."
sleep 3
reboot

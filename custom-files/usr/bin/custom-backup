#!/bin/sh
#========================================================================
# OpenWrt 通用 /etc 配置备份脚本（全量 / 增量双模式）
# 自动适配 OverlayFS / Btrfs / EXT4，始终排除运行时临时文件
#========================================================================
#
# 📖 使用方式说明
# ------------------------------------------------------------------------
# 1. 全量备份（默认模式，清除旧备份后完整复制）
#    sh owrt_etc_backup.sh
#    FULLBACKUP=1 sh owrt_etc_backup.sh
#
# 2. 增量备份（仅备份指定时间内修改的文件，与已有备份合并）
#    FULLBACKUP=0 sh owrt_etc_backup.sh                # 默认24小时
#    FULLBACKUP=0 INCREMENTAL_HOURS=48 sh owrt_etc_backup.sh  # 自定义48小时
#
# 3. 变量说明
#    FULLBACKUP        : 1=全量(默认) | 0=增量
#    INCREMENTAL_HOURS : 增量备份的时间窗口(小时)，仅当 FULLBACKUP=0 时生效，默认24
#    备份目录已硬编码为 /mnt/backup/etc，请确保该路径所在存储设备已挂载
#
# 4. 注意事项
#    - 增量备份是合并式：变更文件按原始目录结构覆盖到备份目录中
#    - 极老版本 BusyBox(<19.07) 可能不支持 date -d，增量模式会报错提示用全量
#    - OverlayFS 环境下仅备份 upperdir 可写层，whiteout 文件自动跳过
#    - 首次使用前请通过 df -h /mnt/backup 确认存储设备已正确挂载
# ========================================================================

BACKUP_DIR="/mnt/backup/etc"
FULLBACKUP="${FULLBACKUP:-1}"
INCREMENTAL_HOURS="${INCREMENTAL_HOURS:-24}"

INFO="\033[94m[INFO]\033[0m"
WARN="\033[93m[WARN]\033[0m"
ERROR="\033[91m[ERROR]\033[0m"
SUCCESS="\033[92m[SUCCESS]\033[0m"

error_exit() { printf "%b %s\n" "${ERROR}" "$1"; exit 1; }

# ==================== 1. 智能探测真实可写源路径 ====================
detect_source() {
    if mount | grep -qE "on / type overlay|on /etc type overlay"; then
        UPPER=$(mount | grep -E "on / type overlay|on /etc type overlay" \
            | sed -n 's/.*upperdir=$[^,]*$.*/\1/p' | head -n1)
        if [ -d "$UPPER/etc" ]; then
            SOURCE="$UPPER/etc"
            printf "%b 检测到 OverlayFS，仅备份可写层: %s\n" "${INFO}" "$SOURCE"
            return
        fi
    fi
    SOURCE="/etc"
    printf "%b 使用标准路径: %s\n" "${INFO}" "$SOURCE"
}

# ==================== 2. 前置校验 ====================
[ "$(id -u)" -eq 0 ] || error_exit "请以 root 权限运行"
detect_source
[ -d "$SOURCE" ] || error_exit "源目录 [$SOURCE] 不存在"
mkdir -p "$BACKUP_DIR" 2>/dev/null || error_exit "无法创建备份目录 [$BACKUP_DIR]，请检查存储设备挂载"

# ==================== 3. 构建排除参数（POSIX 兼容） ====================
EXCLUDE_ARGS="--exclude=./run --exclude=./tmp --exclude=./cache --exclude=./log --exclude=./logs --exclude=./opkg-lists --exclude=./rc.d --exclude=./config/.running --exclude=*.log --exclude=*.tmp --exclude=*.pid --exclude=*.sock"

# ==================== 4. 执行备份 ====================
if [ "$FULLBACKUP" -eq 1 ]; then
    # ---------- 全量备份 ----------
    printf "%b 执行全量备份...\n" "${INFO}"
    if [ -e "$BACKUP_DIR" ]; then
        printf "%b 移除旧的全量备份...\n" "${INFO}"
        rm -rf "$BACKUP_DIR" || error_exit "无法删除旧备份，可能被进程占用"
        mkdir -p "$BACKUP_DIR" || error_exit "无法重建备份目录"
    fi
    # shellcheck disable=SC2086
    tar cf - -C "$SOURCE" $EXCLUDE_ARGS . | tar xf - -C "$BACKUP_DIR"
    TAR_EXIT=$?
else
    # ---------- 增量备份（按修改时间过滤） ----------
    printf "%b 执行增量备份（%s小时内修改的文件）...\n" "${INFO}" "$INCREMENTAL_HOURS"
    mkdir -p "$BACKUP_DIR" 2>/dev/null

    # 生成时间戳参考文件（BusyBox date 双兜底）
    REF_FILE="/tmp/.etc_backup_ref_$$"
    PAST_TS=$(date -d "-${INCREMENTAL_HOURS} hours" "+%Y%m%d%H%M.%S" 2>/dev/null)
    if [ -z "$PAST_TS" ]; then
        NOW_EPOCH=$(date +%s)
        PAST_EPOCH=$((NOW_EPOCH - INCREMENTAL_HOURS * 3600))
        PAST_TS=$(date -d "@${PAST_EPOCH}" "+%Y%m%d%H%M.%S" 2>/dev/null)
    fi
    if [ -z "$PAST_TS" ]; then
        rm -f "$REF_FILE" 2>/dev/null
        error_exit "当前 BusyBox date 不支持时间偏移计算，请使用 FULLBACKUP=1"
    fi
    touch -t "$PAST_TS" "$REF_FILE"

    # 查找指定时间内修改的文件（排除规则在 find 中预过滤）
    FILE_LIST="/tmp/.etc_backup_list_$$"
    find "$SOURCE" -newer "$REF_FILE" -type f \
        ! -path "*/run/*" ! -path "*/tmp/*" ! -path "*/cache/*" \
        ! -path "*/log/*" ! -path "*/logs/*" ! -path "*/opkg-lists/*" \
        ! -path "*/rc.d/*" ! -path "*/config/.running*" \
        ! -name "*.log" ! -name "*.tmp" ! -name "*.pid" ! -name "*.sock" \
        > "$FILE_LIST" 2>/dev/null

    CHANGED_COUNT=$(wc -l < "$FILE_LIST")
    if [ "$CHANGED_COUNT" -eq 0 ]; then
        printf "%b 过去 %s 小时内无配置文件变更，跳过备份\n" "${WARN}" "$INCREMENTAL_HOURS"
        rm -f "$REF_FILE" "$FILE_LIST" 2>/dev/null
        exit 0
    fi

    printf "%b 发现 %s 个变更文件，执行增量复制...\n" "${INFO}" "$CHANGED_COUNT"
    while IFS= read -r filepath; do
        REL_PATH="${filepath#${SOURCE}/}"
        DEST_FILE="${BACKUP_DIR}/${REL_PATH}"
        DEST_DIR=$(dirname "$DEST_FILE")
        mkdir -p "$DEST_DIR" 2>/dev/null
        cp -a "$filepath" "$DEST_FILE" 2>/dev/null
    done < "$FILE_LIST"

    rm -f "$REF_FILE" "$FILE_LIST" 2>/dev/null
    TAR_EXIT=0
fi

# ==================== 5. 验证并落盘 ====================
if [ "$TAR_EXIT" -ne 0 ]; then
    error_exit "备份传输失败 (exit=$TAR_EXIT)"
fi

[ -d "$BACKUP_DIR" ] || error_exit "备份目录未生成"
FILE_COUNT=$(find "$BACKUP_DIR" -maxdepth 1 | wc -l)
[ "$FILE_COUNT" -gt 1 ] || error_exit "备份目录为空，备份异常"

sync
printf "%b ✅ 备份完成: %s\n" "${SUCCESS}" "$BACKUP_DIR"

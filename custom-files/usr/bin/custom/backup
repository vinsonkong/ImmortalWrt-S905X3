#!/bin/sh
#========================================================================
# OpenWrt 通用 /etc 配置备份脚本（全量 / 增量双模式）
# 自动适配 OverlayFS / Btrfs / EXT4，始终排除运行时临时文件
# 排除规则统一读取自 /etc/backup-exclude.lst
#========================================================================
#
# 📖 使用方式说明
# ------------------------------------------------------------------------
# 1. 全量备份（默认模式，清除旧备份后完整复制）
#    sh owrt_etc_backup.sh
#    FULLBACKUP=1 sh owrt_etc_backup.sh
#
# 2. 增量备份（仅备份指定时间内修改的文件，与已有备份合并）
#    FULLBACKUP=0 sh owrt_etc_backup.sh                # 默认24小时
#    FULLBACKUP=0 INCREMENTAL_HOURS=48 sh owrt_etc_backup.sh  # 自定义48小时
#
# 3. 变量说明
#    FULLBACKUP        : 1=全量(默认) | 0=增量
#    INCREMENTAL_HOURS : 增量备份的时间窗口(小时)，仅当 FULLBACKUP=0 时生效，默认24
#    备份目录已硬编码为 /mnt/backup/etc，请确保该路径所在存储设备已挂载
#
# 4. 注意事项
#    - 增量备份是合并式：变更文件按原始目录结构覆盖到备份目录中
#    - 极老版本 BusyBox(<19.07) 可能不支持 date -d，增量模式会报错提示用全量
#    - OverlayFS 环境下仅备份 upperdir 可写层，whiteout 文件自动跳过
#    - 首次使用前请通过 df -h /mnt/backup 确认存储设备已正确挂载
# ========================================================================

BACKUP_DIR="/mnt/backup/etc"
EXCLUDE_FILE="/usr/bin/custom/backup-exclude.lst"
FULLBACKUP="${FULLBACKUP:-1}"
INCREMENTAL_HOURS="${INCREMENTAL_HOURS:-24}"

INFO="\033[94m[INFO]\033[0m"
WARN="\033[93m[WARN]\033[0m"
ERROR="\033[91m[ERROR]\033[0m"
SUCCESS="\033[92m[SUCCESS]\033[0m"

error_exit() { printf "%b %s\n" "${ERROR}" "$1"; exit 1; }

detect_source() {
    if mount | grep -qE "on / type overlay|on /etc type overlay"; then
        UPPER=$(mount | grep -E "on / type overlay|on /etc type overlay" \
            | sed -n 's/.*upperdir=$[^,]*$.*/\1/p' | head -n1)
        if [ -d "$UPPER/etc" ]; then
            SOURCE="$UPPER/etc"
            printf "%b OverlayFS可写层: %s\n" "${INFO}" "$SOURCE"
            return
        fi
    fi
    SOURCE="/etc"
}

build_find_excludes() {
    FIND_EXCLUDE=""
    [ -f "$EXCLUDE_FILE" ] || return
    while IFS= read -r pattern || [ -n "$pattern" ]; do
        case "$pattern" in ""|\#*) continue ;; esac
        case "$pattern" in
            ./*) dir_name="${pattern#./}"; FIND_EXCLUDE="$FIND_EXCLUDE ! -path \"*/${dir_name}/*\" ! -name \"${dir_name}\"" ;;
            \*.*) FIND_EXCLUDE="$FIND_EXCLUDE ! -name \"$pattern\"" ;;
            *) FIND_EXCLUDE="$FIND_EXCLUDE ! -name \"$pattern\"" ;;
        esac
    done < "$EXCLUDE_FILE"
}

[ "$(id -u)" -eq 0 ] || error_exit "请以root权限运行"
detect_source
[ -d "$SOURCE" ] || error_exit "源目录[$SOURCE]不存在"
mkdir -p "$BACKUP_DIR" 2>/dev/null || error_exit "无法创建备份目录[$BACKUP_DIR]"

if [ "$FULLBACKUP" -eq 1 ]; then
    printf "%b 执行全量备份...\n" "${INFO}"
    [ -e "$BACKUP_DIR" ] && { rm -rf "$BACKUP_DIR" || error_exit "无法删除旧备份"; mkdir -p "$BACKUP_DIR" || error_exit "无法重建备份目录"; }
    if [ -f "$EXCLUDE_FILE" ]; then
        tar cf - -C "$SOURCE" --exclude-from="$EXCLUDE_FILE" . | tar xf - -C "$BACKUP_DIR"
    else
        tar cf - -C "$SOURCE" . | tar xf - -C "$BACKUP_DIR"
    fi
    TAR_EXIT=$?
else
    printf "%b 增量备份(%sh内变更)...\n" "${INFO}" "$INCREMENTAL_HOURS"
    mkdir -p "$BACKUP_DIR" 2>/dev/null
    REF_FILE="/tmp/.etc_backup_ref_$$"
    PAST_TS=$(date -d "-${INCREMENTAL_HOURS} hours" "+%Y%m%d%H%M.%S" 2>/dev/null)
    if [ -z "$PAST_TS" ]; then
        NOW_EPOCH=$(date +%s)
        PAST_EPOCH=$((NOW_EPOCH - INCREMENTAL_HOURS * 3600))
        PAST_TS=$(date -d "@${PAST_EPOCH}" "+%Y%m%d%H%M.%S" 2>/dev/null)
    fi
    [ -z "$PAST_TS" ] && { rm -f "$REF_FILE" 2>/dev/null; error_exit "BusyBox date不支持时间偏移，请使用FULLBACKUP=1"; }
    touch -t "$PAST_TS" "$REF_FILE"
    build_find_excludes
    FILE_LIST="/tmp/.etc_backup_list_$$"
    eval "find \"$SOURCE\" -newer \"$REF_FILE\" -type f $FIND_EXCLUDE" > "$FILE_LIST" 2>/dev/null
    CHANGED_COUNT=$(wc -l < "$FILE_LIST")
    if [ "$CHANGED_COUNT" -eq 0 ]; then
        printf "%b 无变更文件，跳过\n" "${WARN}"
        rm -f "$REF_FILE" "$FILE_LIST" 2>/dev/null; exit 0
    fi
    printf "%b %s个变更文件，增量复制...\n" "${INFO}" "$CHANGED_COUNT"
    while IFS= read -r filepath; do
        REL_PATH="${filepath#${SOURCE}/}"
        DEST_FILE="${BACKUP_DIR}/${REL_PATH}"
        mkdir -p "$(dirname "$DEST_FILE")" 2>/dev/null
        cp -a "$filepath" "$DEST_FILE" 2>/dev/null
    done < "$FILE_LIST"
    rm -f "$REF_FILE" "$FILE_LIST" 2>/dev/null
    TAR_EXIT=0
fi

printf "%b 清理空文件夹...\n" "${INFO}"
if find /tmp -maxdepth 0 -empty >/dev/null 2>&1; then
    find "$BACKUP_DIR" -mindepth 1 -type d -empty -delete 2>/dev/null
else
    find "$BACKUP_DIR" -mindepth 1 -depth -type d 2>/dev/null | while IFS= read -r dir; do
        [ -z "$(ls -A "$dir" 2>/dev/null)" ] && rmdir "$dir" 2>/dev/null
    done
fi
CLEANED_COUNT=$(find "$BACKUP_DIR" -mindepth 1 -type d -empty 2>/dev/null | wc -l)
[ "$CLEANED_COUNT" -eq 0 ] && printf "%b ✅ 无空文件夹\n" "${SUCCESS}" || printf "%b ⚠️ %s个空文件夹未清理\n" "${WARN}" "$CLEANED_COUNT"

[ "$TAR_EXIT" -ne 0 ] && error_exit "备份传输失败(exit=$TAR_EXIT)"
[ -d "$BACKUP_DIR" ] || error_exit "备份目录未生成"
[ "$(find "$BACKUP_DIR" -maxdepth 1 | wc -l)" -gt 1 ] || error_exit "备份目录为空"
sync
printf "%b ✅ 备份完成: %s\n" "${SUCCESS}" "$BACKUP_DIR"
